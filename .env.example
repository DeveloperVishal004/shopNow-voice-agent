# Required
openai_api_key=your_openai_api_key_here
sarvam_api_key=your_sarvam_api_key_here
# Optional (Defaults shown)
DATABASE_URL=sqlite:///./shopnow.db
FAISS_INDEX_PATH=./rag_store/index/faiss.index
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_TOKENS=200

# TTS Configuration
TTS_MODEL=tts-1
TTS_VOICE=nova

# Escalation Configurations
ESCALATION_NEGATIVE_TURNS=4
ESCALATION_SENTIMENT_THRESHOLD=-0.7
ESCALATION_MIN_TURNS=3
ESCALATION_MAX_TURNS=8                 # escalate if a call runs this many customer turns unresolved
ESCALATION_DATA_NOT_FOUND_LIMIT=2      # escalate after this many failed backend data lookups
ESCALATION_UNKNOWN_INTENT_LIMIT=3      # escalate after this many consecutive unclassified queries